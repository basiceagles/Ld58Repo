  lines:
  - speakerName: '[Unknown frequency]'
    text: Don't do this. Please.
    voiceClip: {fileID: 0}
  - speakerName: '[Unknown frequency]'
    text: Don't relay that signal.
    voiceClip: {fileID: 0}
  - speakerName: '[Unknown frequency]'
    text: "If you transmit it \u2014 the world will be gone by tomorrow."
    voiceClip: {fileID: 0}
  - speakerName: '[Unknown frequency]'
    text: Ha. Right. You don't believe me...
    voiceClip: {fileID: 0}
  - speakerName: '[Unknown frequency]'
    text: They pay you well, don't they?
    voiceClip: {fileID: 0}
  - speakerName: '[Unknown frequency]'
    text: Listen, I can prove-
    voiceClip: {fileID: 0}
  - speakerName: '[Unknown frequency]'
    text: '[Signal lost]'
    voiceClip: {fileID: 0}
