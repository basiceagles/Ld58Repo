  m_Script: {fileID: 11500000, guid: 9ad8ad1aa6568f544aa4f6e7c6c0c8a4, type: 3}
  m_Name: Dialogue_Call1
  m_EditorClassIdentifier: 
  lines:
  - speakerName: '[Unknown frequency]'
    text: "I've printed the decryption keys for you.\nCheck to the right of this
      terminal \u2014 pick them up with \"E\"."
    voiceClip: {fileID: 0}
  - speakerName: '[Unknown frequency]'
    text: Walk up to your antenna and press "i".
    voiceClip: {fileID: 0}
  - speakerName: '[Unknown frequency]'
    text: Decrypt all 5 segments and you'll see exactly what this signal contains.
    voiceClip: {fileID: 0}
  - speakerName: '[Unknown frequency]'
    text: Each antenna can only decrypt one segment.
    voiceClip: {fileID: 0}
  - speakerName: '[Unknown frequency]'
    text: "Please.\nDo this \u2014 not for me."
    voiceClip: {fileID: 0}
  - speakerName: '[Unknown frequency]'
    text: For your family.
    voiceClip: {fileID: 0}
